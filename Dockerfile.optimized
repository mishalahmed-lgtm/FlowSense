# Optimized Dockerfile for faster deployments
FROM python:3.12-slim

WORKDIR /app

# Install only essential system dependencies (removed Java - not needed for core functionality)
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
# Use requirements-minimal.txt for faster builds
COPY requirements-minimal.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy only necessary application code (exclude test files, docs, etc.)
COPY main.py config.py database.py models.py auth.py admin_auth.py ./
COPY routers/ ./routers/
COPY services/ ./services/
COPY validators.py error_handler.py metrics.py ./

# Expose port (Render will set PORT env var)
EXPOSE 5000

# Run the application
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-5000}"]

